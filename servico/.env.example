# Copie para servico/.env e preencha. O .env é relido a cada requisição:
# ao colocar a GEMINI_API_KEY aqui, a próxima sessão já usa o Gemini, sem reiniciar a API.

# Chave da API do Gemini (https://aistudio.google.com/apikey). Vazio = texto por template local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tentados em ordem se o principal falhar (ex.: 503 por alta demanda).
GEMINI_MODELOS_RESERVA=gemini-3.7-flash,gemini-flash-latest
GEMINI_TIMEOUT_S=20

# Chaves aceitas no header X-API-Key, separadas por vírgula.
TRIAGEM_API_KEYS=demo-mvp-key

# Origens liberadas no CORS (o MVP roda como site estático).
TRIAGEM_CORS_ORIGINS=*
